# Where the local Transcripe engine lives, as seen from your phone.
# Laptop and phone must share a Wi-Fi network. Start the engine with:
#   transcripe studio --lan
# It prints both lines below, ready to paste.
EXPO_PUBLIC_API_URL=http://YOUR-LAPTOP-LAN-IP:8000

# A studio open to the network is token-protected.
EXPO_PUBLIC_API_TOKEN=
